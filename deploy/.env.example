# music 站运行时配置（复制为 .env 后按需修改；compose 与 Makefile 读取）。

# ── 站点寻址 ──────────────────────────────────────────────
# 对外域名（nginx server_name，须与 DNS AAAA 记录一致）
MUSIC_DOMAIN=music.chaoset.com
# 站点公网 IPv6（宿主 ipvlan_docker 网络内分配，必填）
MUSIC_IPV6=

# ── App 接口令牌 ─────────────────────────────────────────
# 可选应用层鉴权：配置后业务端点要求 X-App-Token（与 media_server 同构）；
# 留空 = 依赖边缘 CF mTLS
MUSIC_SERVER_APP_API_TOKEN=
# 可选：静态网易云 cookie（与 cookie 文件二选一；扫码登录写入的文件优先生效）
NETEASE_MUSIC_COOKIE=

# ── 站内管理(/admin/)─────────────────────────────────────
# 可选管理令牌兜底:配置后 /admin/api/v1/* 额外要求 X-Admin-Token 头
# （边缘 htpasswd 基础认证之外的第二道闸;留空仅依赖边缘认证）
MUSIC_SERVER_ADMIN_TOKEN=
